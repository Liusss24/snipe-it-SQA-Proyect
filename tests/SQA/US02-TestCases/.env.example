# Snipe-IT base URL (no trailing slash)
SNIPEIT_BASE_URL=http://localhost:8000

# Admin API token (Settings > API > Generate Token)
SNIPEIT_API_TOKEN=your_admin_api_token_here

# API token for the restricted user (viewer / sin permisos de checkout)
# Generate with artisan tinker for the viewer user (see project-structure.md)
SNIPEIT_NOPERM_TOKEN=your_viewer_api_token_here

# Docker / MariaDB access (used by DbHelper for direct DB queries in CP-HU02-04)
SNIPEIT_DB_CONTAINER=snipeit-db-1
SNIPEIT_DB_NAME=snipeit_db
SNIPEIT_DB_USER=snipeit_user
SNIPEIT_DB_PASS=your_db_password
