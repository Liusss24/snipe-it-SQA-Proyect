# Snipe-IT base URL (no trailing slash)
SNIPEIT_BASE_URL=http://localhost:8000

# Admin credentials for UI login
SNIPEIT_ADMIN_USERNAME=admin
SNIPEIT_ADMIN_PASSWORD=password

# Admin API token (generate via: php artisan tinker -> user->createToken('qa')->accessToken)
SNIPEIT_API_TOKEN=your_api_token_here

# Alert email used during tests (does not need to be a real inbox; MAIL_MAILER=log in .env)
SNIPEIT_ALERT_EMAIL=qa-alerts@example.test

# Docker / Artisan prefix for running artisan commands (expiring-alerts, schedule:list)
# Use: docker exec <container> php artisan
SNIPEIT_ARTISAN_PREFIX=docker exec proyecto_qa-app-1 php artisan
